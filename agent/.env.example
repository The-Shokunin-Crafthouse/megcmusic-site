# agent/.env — local Mac generation daemon config.
# Copy this file to agent/.env and fill in real values. agent/.env is
# gitignored — never commit it, never paste real values into this example.

# Positive default-off flag (studio learning #73): the daemon is a clean
# no-op unless this is exactly "1". Unset, empty, or any other value = the
# daemon logs one line and exits 0.
PLAYBOOK_AGENT_ENABLED=1

# Supabase project that holds the megcmusic-outreach app database (same
# project the Next.js app's SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY point
# at — see .env.local.example at the repo root). Server-only service role
# key: never expose it in a browser, never commit it.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional — path to the claude CLI. Defaults to "claude" (resolved via
# PATH). Set this explicitly if launchd's minimal environment can't find it
# (e.g. installed via nvm/homebrew in a non-standard location) — run
# `command -v claude` in a normal terminal to find the right value.
CLAUDE_BIN=claude

# Optional — queue poll interval in milliseconds. Defaults to 5000.
POLL_INTERVAL_MS=5000
