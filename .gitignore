# ============================================================
# .gitignore — Shokunin Crafthouse project template
# ============================================================

# dependencies
node_modules/
.pnp
.pnp.js
.yarn/
.pnpm-store/

# build outputs
.next/
.turbo/
.svelte-kit/
.astro/
dist/
build/
out/

# Next.js / TypeScript generated
next-env.d.ts
*.tsbuildinfo

# testing / coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# stray output from ad-hoc screenshot tooling when its dest var is unset
/undefined/

# env files — never commit
.env
.env.*
!.env.example
!.env.local.example

# secrets
secrets/
*.key
*.pem
*.p12
*.mobileprovision
*.keystore
credentials.json
service-account*.json

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# deploy artifacts
.vercel/
.netlify/
.wrangler/

# caches
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# Figma bulk exports (keep structure, not assets)
stages/02-design/figma/exports/

# model-local artifacts
.claude-cache/
.cursor-cache/
.ai-cache/
.vercel
\!.vercel/project.json
!.vercel/project.json

# Playwright MCP scratch artifacts
.playwright-mcp/

# Megs Playbook local generation daemon (Sprint 10) — real Supabase service
# role key lives in agent/.env, never committed; runtime logs are local only.
agent/.env
agent/logs/*
!agent/logs/.gitkeep

# FYC lyric sheets are fetched from WP at build (scripts/fetch-fyc-assets.mjs)
/public/images/fyc/

# Per-page hero photos are downloaded from WP at build
# (scripts/fetch-hero-images.mjs); the manifest in src/generated is committed.
/public/images/page-hero/
