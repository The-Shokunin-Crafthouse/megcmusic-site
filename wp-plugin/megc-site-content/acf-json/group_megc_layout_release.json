{
  "key": "group_megc_layout_release",
  "title": "Page layout — this release's page",
  "fields": [
    {
      "key": "field_megc_layout_release",
      "label": "Page layout",
      "name": "layout_release",
      "type": "flexible_content",
      "button_label": "Add a section or a block",
      "instructions": "The order of this page, top to bottom, under its heading. Add the page's own sections to drag them into a new order or hide one; add a block — an announcement, a quote, a video, a text section, a photo — to put something new between them. Anything you leave out keeps its usual place after what you list. Leave the whole list empty and the page looks exactly as it does today.",
      "layouts": {
        "layout_megc_release_section_record": {
          "key": "layout_megc_release_section_record",
          "name": "section_record",
          "label": "Section: About the Record + Liner Notes & Lyrics",
          "display": "row",
          "max": 1,
          "sub_fields": [
            {
              "key": "field_megc_layout_release_section_record_hidden",
              "label": "Hide this section",
              "name": "hidden",
              "type": "true_false",
              "ui": 1,
              "default_value": 0,
              "instructions": "This page's text and lyric images."
            }
          ]
        },
        "layout_megc_release_section_press": {
          "key": "layout_megc_release_section_press",
          "name": "section_press",
          "label": "Section: What People Are Saying",
          "display": "row",
          "max": 1,
          "sub_fields": [
            {
              "key": "field_megc_layout_release_section_press_hidden",
              "label": "Hide this section",
              "name": "hidden",
              "type": "true_false",
              "ui": 1,
              "default_value": 0,
              "instructions": "The quotes and accolades list on this page."
            }
          ]
        },
        "layout_megc_release_announcement": {
          "key": "layout_megc_release_announcement",
          "name": "announcement",
          "label": "Announcement",
          "display": "block",
          "sub_fields": [
            {
              "key": "field_megc_layout_release_ann_eyebrow",
              "label": "Small line above",
              "name": "eyebrow",
              "type": "text",
              "instructions": "Optional. e.g. “New single” or “Award season”."
            },
            {
              "key": "field_megc_layout_release_ann_headline",
              "label": "Headline",
              "name": "headline",
              "type": "text",
              "instructions": "What people read first. Required — a block without a headline does not show.",
              "required": 1
            },
            {
              "key": "field_megc_layout_release_ann_body",
              "label": "Text",
              "name": "body",
              "type": "textarea",
              "instructions": "Optional. A sentence or two.",
              "rows": 3
            },
            {
              "key": "field_megc_layout_release_ann_link_label",
              "label": "Link text",
              "name": "link_label",
              "type": "text",
              "instructions": "Optional. e.g. “Listen now”. Needs a link address too."
            },
            {
              "key": "field_megc_layout_release_ann_link_url",
              "label": "Link address",
              "name": "link_url",
              "type": "url",
              "instructions": "Optional. Where the link goes."
            }
          ]
        },
        "layout_megc_release_pull_quote": {
          "key": "layout_megc_release_pull_quote",
          "name": "pull_quote",
          "label": "Pull quote",
          "display": "block",
          "sub_fields": [
            {
              "key": "field_megc_layout_release_quote_text",
              "label": "Quote",
              "name": "quote",
              "type": "textarea",
              "instructions": "The quote itself, without quotation marks. Required.",
              "required": 1,
              "rows": 3
            },
            {
              "key": "field_megc_layout_release_quote_attribution",
              "label": "Who said it",
              "name": "attribution",
              "type": "text",
              "instructions": "e.g. “Americana Highways”."
            }
          ]
        },
        "layout_megc_release_video": {
          "key": "layout_megc_release_video",
          "name": "video",
          "label": "Video",
          "display": "block",
          "sub_fields": [
            {
              "key": "field_megc_layout_release_video_url",
              "label": "YouTube link",
              "name": "youtube_url",
              "type": "url",
              "instructions": "Any YouTube link — watch, Shorts, or share. Required.",
              "required": 1
            },
            {
              "key": "field_megc_layout_release_video_caption",
              "label": "Caption",
              "name": "caption",
              "type": "text",
              "instructions": "Optional. One line under the video."
            }
          ]
        },
        "layout_megc_release_text": {
          "key": "layout_megc_release_text",
          "name": "text",
          "label": "Text section",
          "display": "block",
          "sub_fields": [
            {
              "key": "field_megc_layout_release_text_heading",
              "label": "Heading",
              "name": "heading",
              "type": "text",
              "instructions": "Shown between the ★★★ like every section heading. Required.",
              "required": 1
            },
            {
              "key": "field_megc_layout_release_text_body",
              "label": "Paragraphs",
              "name": "body",
              "type": "textarea",
              "instructions": "Leave an empty line between paragraphs. Required — a section with no text does not show.",
              "required": 1,
              "rows": 8,
              "new_lines": ""
            }
          ]
        },
        "layout_megc_release_photo": {
          "key": "layout_megc_release_photo",
          "name": "photo",
          "label": "Photo",
          "display": "block",
          "sub_fields": [
            {
              "key": "field_megc_layout_release_photo_image",
              "label": "Photo",
              "name": "image",
              "type": "image",
              "return_format": "array",
              "preview_size": "medium",
              "library": "all",
              "instructions": "Required. The photo's own “Alternative Text” in the Media Library is what a screen reader hears — set it there.",
              "required": 1
            },
            {
              "key": "field_megc_layout_release_photo_caption",
              "label": "Caption",
              "name": "caption",
              "type": "text",
              "instructions": "Optional. One line under the photo."
            }
          ]
        }
      }
    }
