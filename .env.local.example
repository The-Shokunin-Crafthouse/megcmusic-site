WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
# WordPress/WooCommerce host origin. Unset = apex (https://megcmusic.com), today's
# model. At launch cutover — Next site takes megcmusic.com, WP moves to its own
# subdomain — set this to that subdomain (e.g. https://admin.megcmusic.com) and
# rebuild; every REST base + outbound WP-page link follows it. NEXT_PUBLIC_ (server
# + browser), bakes at build. The three per-endpoint overrides below still win if set.
NEXT_PUBLIC_WP_ORIGIN=
WC_API_URL=
WP_API_URL=
EVENTS_API_URL=
NEXT_PUBLIC_BEHOLD_FEED_ID=
NEXT_PUBLIC_SITE_URL=

# /booking form → emails the enquiry here via the Gmail API (reuses GMAIL_* below).
# Optional override; defaults to meghanclarisse@gmail.com in code. Set only to
# route booking enquiries to a different address.
BOOKING_TO=

# Booking Outreach Engine (server-only — never NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OUTREACH_API_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
