WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
# WordPress/WooCommerce host origin. The cutover has happened: the Next site owns
# the apex megcmusic.com and WordPress lives at https://admin.megcmusic.com, which
# is the code default when this is unset. The apex 403s every /wp-json path — never
# point this back at it. Every REST base + outbound WP-page link follows this value.
# NEXT_PUBLIC_ (server + browser), bakes at build. The three per-endpoint overrides
# below still win if set — leave them blank unless you mean to diverge.
NEXT_PUBLIC_WP_ORIGIN=https://admin.megcmusic.com
WC_API_URL=
WP_API_URL=
EVENTS_API_URL=
NEXT_PUBLIC_BEHOLD_FEED_ID=
NEXT_PUBLIC_SITE_URL=

# /booking form → emails the enquiry here via the Gmail API (reuses GMAIL_* below).
# Optional override; defaults to meghanclarisse@gmail.com in code. Set only to
# route booking enquiries to a different address.
BOOKING_TO=

# Booking Outreach Engine (server-only — never NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OUTREACH_API_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Social Playbook Dashboard (server-only — never NEXT_PUBLIC_)
# System User token, non-expiring by design (2026-07-10 ADR) — no refresh flow.
META_SYSTEM_USER_TOKEN=
# Vercel injects this automatically for cron invocations when set; set it
# yourself for local manual testing of /api/playbook/sync.
CRON_SECRET=
